# Public browser configuration only. Do not place secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SITE_URL=https://www.taskpilotapp.online
NEXT_PUBLIC_API_BASE_URL=https://api.taskpilotapp.online

# Backend-only configuration. Store the real values on AWS, never in Git.
POCKETBASE_URL=http://127.0.0.1:8090
FRONTEND_ORIGINS=https://www.taskpilotapp.online,https://taskpilotapp.online
# Lets the AWS API session cookie be read by the Vercel website in production.
AUTH_COOKIE_DOMAIN=.taskpilotapp.online
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=
ENCRYPTION_MASTER_KEY=

VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=

# Optional public browser configuration for the dashboard chat button.
NEXT_PUBLIC_WHATSAPP_NUMBER=

GEMINI_API_KEY=

# Razorpay server-only billing configuration. Add test values first; never use
# NEXT_PUBLIC_ for the key secret or webhook secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=120
